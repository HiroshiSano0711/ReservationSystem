.l-main
  h1.p-txt-primary = "#{@team.name}の予約ページ"
  p.p-txt-sub 予約内容の確認

  .reservation-summary
    dl
      dt メニュー
      dd = @draft.service_menus.map(&:name).join(", ")

      dt 担当者:
      dd  = @draft.staff.present? ? @draft.staff.profile.nick_name : "おまかせ"

      dt 予約日時:
      dd = "#{@draft.start_time.strftime('%Y年%m月%d日') } #{@draft.start_time.strftime("%H:%M")}~#{@draft.end_time.strftime("%H:%M")}"

      dt 所要時間
      dd = "#{@draft.service_menus.sum(&:duration)}分"

      dt 価格:
      dd = number_to_currency(@draft.service_menus.sum(&:price), locale: 'ja')

  = form_with model: @form, url: reservations_finalize_path(@team.permalink), local: true do |f|
    - if current_customer.present? && current_customer.profile.present?
      = f.hidden_field :customer_name, value: current_customer.profile.name
      = f.hidden_field :customer_phone_number, value: current_customer.profile.phone_number
      dl
        dt お名前
        dd = current_customer.profile.name

        dt 電話番号
        dd  = current_customer.profile.phone_number

    - else
      p
        strong 顧客情報:
        | 最後にお名前と連絡先電話番号を入力してください

      - if @form.errors.any?
        .p-notice.p-notice--alert
          ul
            - @form.errors.full_messages.each do |msg|
              li = msg

      = f.label :customer_name
      = f.text_field :customer_name
      = f.label :customer_phone_number
      = f.telephone_field :customer_phone_number

    .actions
      = f.submit "予約を確定する"
